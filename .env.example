# URL base do backend ECO (sem barra final)
# Em dev local: deixe VAZIO — o proxy do Vite (vite.config.ts) redireciona /api/* automaticamente
# Em produção (Vercel): defina como a URL completa do backend
VITE_API_URL=https://ecobackend888.onrender.com

# URL base do app (sem barra final)
# Em dev local: deixe VAZIO — o hook usa http://localhost:5173 automaticamente
# Em produção: defina como a URL do app React
VITE_APP_URL=https://ecofrontend888.vercel.app
